# Docker sul PC (database, o tutto con l'app). Copia questo file in .env.db (non va su git) e cambia le password
# (solo lettere e cifre).
#   npm run db:up       solo il database (per sviluppare con npm run dev / build:server)
#   npm run db:migrate:dev  crea le tabelle (con DATABASE_URL qui sotto)
#   npm run docker:up   tutto in Docker: database, utenti, migrazioni e app su http://localhost:3000
#   npm run db:down     ferma i container (i dati restano nel volume)
POSTGRES_PASSWORD=cambiaquestapasswordadmin
APP_DB_PASSWORD=cambiaquestapassword
APP_RUNTIME_PASSWORD=cambiaquestapasswordapp
DB_PORT=55432
APP_PORT=3000
# Per gli script e l'app avviata fuori da Docker (stessa password di APP_DB_PASSWORD):
DATABASE_URL=postgres://tonecraft:cambiaquestapassword@127.0.0.1:55432/tonecraft
