# Database in Docker per lo sviluppo sul PC. Copia questo file in .env.db (non va su git) e cambia le password.
#   npm run db:up       avvia il container
#   npm run db:migrate  crea le tabelle (con DATABASE_URL qui sotto)
POSTGRES_PASSWORD=cambia-questa-password-admin
APP_DB_PASSWORD=cambiaquestapassword
DB_PORT=55432
# Per l'app e gli script (stessa password di APP_DB_PASSWORD):
DATABASE_URL=postgres://tonecraft:cambiaquestapassword@127.0.0.1:55432/tonecraft
